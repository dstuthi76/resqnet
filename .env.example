# Copy to .env (same folder) and fill in. NEVER commit .env - it is in .gitignore.

# ---- AI (free key: https://aistudio.google.com -> Get API key). Empty = offline rule-based triage.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# ---- Privacy: random secret used to hash household identities (any long random string)
ID_SALT=replace-with-a-long-random-string

# ---- Blockchain: "sim" (no keys needed) or "sepolia"
CHAIN_MODE=sim
# Alchemy / Infura Sepolia URL, e.g. https://eth-sepolia.g.alchemy.com/v2/<key>
SEPOLIA_RPC_URL=
# Private key of a NEW, TEST-ONLY MetaMask account holding Sepolia ETH (0x...)
ORACLE_PRIVATE_KEY=
# Filled in after `npm run deploy:sepolia` (the script prints these lines)
CONTRACT_ADDRESS=
NGO_PRIVATE_KEYS=
# Optional, for `npx hardhat verify`
ETHERSCAN_API_KEY=

# ---- Payout rule (must match the deployed contract)
PAYOUT_WEI=1000000000000000
HOURS_THRESHOLD=48
CONFIRMATIONS_REQUIRED=2
WAITING_PERIOD_S=0
POOL_FUND_ETH=0.03
NGO_GAS_ETH=0.005

# ---- Optional: Pinata JWT to store delivery photos on IPFS (https://app.pinata.cloud -> API Keys)
PINATA_JWT=

# ---- Optional: protect /api/demo/* endpoints on a public deployment
ADMIN_TOKEN=
